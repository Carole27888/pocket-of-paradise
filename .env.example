# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------- core
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string-50-characters-or-more
ALLOWED_HOSTS=app.pocketofparadise.co.ke
CSRF_TRUSTED_ORIGINS=https://app.pocketofparadise.co.ke
SITE_URL=https://app.pocketofparadise.co.ke
ADMINS=Anne Wairimu:admin@pocketofparadise.co.ke

# ---------------------------------------------------------------- database (pick ONE)
# SQLite (default if unset) — fine for a small office:
# DATABASE_URL=sqlite:////home/cpaneluser/dsa/db.sqlite3
# PostgreSQL:
# DATABASE_URL=postgres://dsa_user:password@localhost:5432/dsa_db
# MySQL / MariaDB (cPanel). With PyMySQL (requirements-mysql.txt) also set DB_MYSQL_DRIVER=pymysql:
# DATABASE_URL=mysql://cpuser_dsa:password@localhost:3306/cpuser_dsa
# DB_MYSQL_DRIVER=pymysql
# DB_OPTIONS={"charset": "utf8mb4", "init_command": "SET sql_mode='STRICT_TRANS_TABLES'"}
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True
# Optional read replica for dashboards/reports:
# DATABASE_REPLICA_URL=postgres://reader:password@replica-host:5432/dsa_db

# ---------------------------------------------------------------- cache / email
# CACHE_URL=locmemcache://            (default)  or  redis://127.0.0.1:6379/1
EMAIL_URL=smtp+tls://noreply%40pocketofparadise.co.ke:password@mail.pocketofparadise.co.ke:587
DEFAULT_FROM_EMAIL=Pocket of Paradise Travel Company <noreply@pocketofparadise.co.ke>

# ---------------------------------------------------------------- jobs
# sync = run inline (dev). cron = queued, run by `manage.py run_jobs` every 5 minutes (production).
JOBS_BACKEND=cron
JOBS_RUN_TIME_LIMIT=240

# ---------------------------------------------------------------- security
# Fernet key for passport numbers. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a backup: losing it makes stored passport numbers unreadable.
FIELD_ENCRYPTION_KEY=
LOGIN_RATE_LIMIT=5
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------- PWA + web push
# Bump PWA_VERSION on every deploy so installed apps pick up new files.
PWA_VERSION=1
# Generate VAPID keys: see README "Push notifications"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@pocketofparadise.co.ke

# ---------------------------------------------------------------- integrations
# mock = no external calls (safe default). live = real providers where keys are set.
INTEGRATIONS_MODE=mock
FX_PROVIDER_API_KEY=

# ---------------------------------------------------------------- paths (optional)
# STATIC_ROOT=/home/cpaneluser/public_html/app/static
# MEDIA_ROOT=/home/cpaneluser/dsa/media
# LOG_DIR=/home/cpaneluser/dsa/logs

# ---------------------------------------------------------------- marketing / lead capture
# Shared secret for the website / OTA enquiry webhook (POST /marketing/webhooks/enquiry/, header X-Webhook-Secret).
# Leave empty to disable the webhook. The public /capture/ form works without it.
WEBHOOK_SECRET=
# SMS (Africa's Talking) and WhatsApp Business: only used when INTEGRATIONS_MODE=live
AT_USERNAME=
AT_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Social / ads (live mode): META_ACCESS_TOKEN=  TIKTOK_ACCESS_TOKEN=  GOOGLE_ADS_TOKEN=  YOUTUBE_API_KEY=

# ---------------------------------------------------------------- trips
# A departure inside this many days of leaving that is still missing resources is flagged for attention.
TRIPS_STUCK_DAYS=5

# ---------------------------------------------------------------- security, AI and WhatsApp (phases 8-10)
# Two-step sign-in (TOTP). Roles listed here are forced to enrol; others may opt in under My Space > Security.
TWO_FACTOR_ENABLED=False   # set True in production
TWO_FACTOR_REQUIRED_ROLES=Admin,Finance Officer,Director,COO
# AI (WhatsApp bot + in-app assistant). Prefer saving the key under Administration > Integration Keys (stored encrypted).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Meta app secret: when set, inbound WhatsApp webhook calls must carry a valid X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Optional AI backup (OpenAI) and which provider goes first: claude | openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PREFERRED=claude
# Meta (Facebook/Instagram/WhatsApp) webhook and website lead form
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WEBHOOK_ALLOWED_ORIGINS=
# Agents' own mailboxes use SMTP with their credentials (default shown)
AGENT_MAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
